{
  "name": "mirav-test",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/gen-kazne-javne.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fuzz": "node --import ./scripts/osm/lib/ts-hook.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fuzz-rute.mjs",
    "typecheck": "tsc --noEmit",
    "gen:image-sizes": "node scripts/gen-image-sizes.mjs",
    "gen:kazne": "node scripts/gen-kazne-javne.mjs",
    "translate": "node scripts/translate.mjs",
    "translate:stats": "node scripts/translate.mjs --stats",
    "translate:apply": "node scripts/apply-translations.mjs",
    "translate:check": "node scripts/apply-translations.mjs --check",
    "osm:povuci": "node --import ./scripts/osm/lib/ts-hook.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/osm/povuci.mjs",
    "osm:pripremi": "node --max-old-space-size=6144 --import ./scripts/osm/lib/ts-hook.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/osm/pripremi.mjs",
    "osm:ivice": "node --max-old-space-size=6144 --import ./scripts/osm/lib/ts-hook.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/osm/ivice.mjs",
    "osm:kicme": "node --max-old-space-size=6144 --import ./scripts/osm/lib/ts-hook.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/osm/kicme.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}

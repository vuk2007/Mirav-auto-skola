# ── Prikaz kazni polaznicima ────────────────────────────────────────────────
# PODRAZUMIJEVANO ISKLJUČENO. Vide se samo kazne koje je instruktorka potvrdila
# kroz /admin/kazne. Dok je ovo `false`, kazne se ne prikazuju nigdje i podaci o
# njima ne putuju korisniku.
NEXT_PUBLIC_KAZNE_ENABLED=false

# ── Editor kazni (/admin/kazne) ─────────────────────────────────────────────
# Kad nije `true`, ruta vraća 404. Uputstvo: docs/kazne-azuriranje.md
NEXT_PUBLIC_ADMIN_ENABLED=false

# Lozinka za editor. NEMA prefiks NEXT_PUBLIC_, pa ostaje samo na serveru i
# nikad ne ulazi u kod koji se šalje browseru.
ADMIN_PASSWORD=

# Sve tri se ugrađuju u build — poslije izmjene je potreban novi deploy.

# ── Editor grada (igra, faza 6) ─────────────────────────────────────────────
# Radi samo uz `npm run dev` — u produkcijskom buildu ga nema. Lozinka čuva
# upis overlay-a (public/data/grad/overrides/<grad>.json). Uputstvo:
# docs/grad-editor.md
GRAD_EDITOR_LOZINKA=
